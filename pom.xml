<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.zkjs.aio</groupId>
    <artifactId>wsp-swap</artifactId>
    <version>0.0.1</version>
    <name>wsp-swap</name>
    <description>一体化交换部署服务</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 框架版本统一管控 -->
        <aio-framework.version>1.0.17</aio-framework.version>
        <!-- 打包时跳过测试阶段（极速打包，避免本地/流水线因数据库未连接而中断） -->
        <skipTests>true</skipTests>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.zkjs.aio</groupId>
                <artifactId>aio-framework</artifactId>
                <version>${aio-framework.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <!-- 基础通用组件（包含 WebFlux、统一响应封装、Knife4j 接口文档等，必选） -->
        <dependency>
            <groupId>com.zkjs.aio</groupId>
            <artifactId>aio-spring-boot-starter-common</artifactId>
        </dependency>

        <!-- Lombok 工具类（可选，简化代码） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 数据访问组件：多数据源、MyBatis-Plus、自动建库与版本迁移 -->
        <dependency>
            <groupId>com.zkjs.aio</groupId>
            <artifactId>aio-spring-boot-starter-mybatis-plus</artifactId>
        </dependency>

        <!-- ClickHouse 数据库驱动（底层 starter 为 optional，业务按需引入） -->
        <dependency>
            <groupId>com.clickhouse</groupId>
            <artifactId>clickhouse-jdbc</artifactId>
        </dependency>

        <!-- 缓存与锁组件：Redis 缓存与 Lock4j 分布式锁 -->
        <dependency>
            <groupId>com.zkjs.aio</groupId>
            <artifactId>aio-spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- 鉴权认证时开启，需配合 Redis 配置使用 -->
        <dependency>
            <groupId>com.zkjs.aio</groupId>
            <artifactId>aio-spring-boot-starter-sa-token</artifactId>
        </dependency>

        <!-- 消息队列组件：KafkaTemplate、批量/单条双消费工厂、优雅停机、死信队列 -->
        <dependency>
            <groupId>com.zkjs.aio</groupId>
            <artifactId>aio-spring-boot-starter-kafka</artifactId>
        </dependency>

        <!-- 文档导出套件组件：HTML(Thymeleaf)、Excel(EasyExcel)、Word(Poi-tl)、PDF(x-easypdf) -->
        <dependency>
            <groupId>com.zkjs.aio</groupId>
            <artifactId>aio-spring-boot-starter-doc</artifactId>
        </dependency>

        <!-- 单元测试组件：JUnit 5 与 Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <parameters>true</parameters>
                    <compilerArgs>
                        <arg>-proc:full</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading -Xshare:off -Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>4.1.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 2. Assembly 打包插件：打包生成包含可执行 Jar 与平级 config/ 目录的发布包 (.tar.gz) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <!-- 输出归档名称直接为 wsp-swap.tar.gz，移除版本号和 release 后缀 -->
                    <finalName>wsp-swap</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                    <descriptors>
                        <descriptor>src/main/assembly/assembly.xml</descriptor>
                    </descriptors>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
